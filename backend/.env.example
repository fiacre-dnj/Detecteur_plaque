# Configuration du service — copier en `.env` et adapter.
# `.env` est ignoré par git ; ce fichier-ci est committé et fait référence.
#
# Le code ne lit `os.environ` nulle part : un unique objet Settings
# (src/traffic_analysis/core/settings.py) est chargé au démarrage et injecté.
#
# Une clé mal orthographiée **dans ce fichier** fait échouer le démarrage avec le
# nom fautif, plutôt que d'être ignorée en silence — sans quoi on baisserait la
# limite d'upload en croyant l'avoir faite et elle resterait à 800 Mo. Une
# variable d'environnement mal orthographiée, en revanche, reste indétectable.

# ─── Exécution ────────────────────────────────────────────────────────────────
TRAFFIC_ENV=development                # development | staging | test | production
TRAFFIC_HOST=127.0.0.1
TRAFFIC_PORT=8000

# ─── Journalisation ───────────────────────────────────────────────────────────
TRAFFIC_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
TRAFFIC_LOG_FORMAT=console             # console en développement, json en production

# ─── CORS et hôtes ────────────────────────────────────────────────────────────
# Liste EXPLICITE, jamais "*" — le démarrage échoue si "*" apparaît.
# `localhost` et `127.0.0.1` sont deux origines distinctes pour le navigateur :
# les deux doivent être présentes, sinon « ça marche sur l'une et pas l'autre ».
# En développement la voie normale est le proxy Vite (same-origin) ; CORS n'est
# que le filet pour les appels directs et l'outillage.
TRAFFIC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Pour les déploiements de prévisualisation. Doit être ancrée par ^ et $, sinon
# https://evil.com/#mon-domaine.dev la satisferait par son fragment.
TRAFFIC_CORS_ORIGIN_REGEX=
TRAFFIC_CORS_ALLOW_CREDENTIALS=false
TRAFFIC_TRUSTED_HOSTS=["localhost","127.0.0.1"]

# ─── Persistance ──────────────────────────────────────────────────────────────
TRAFFIC_DATABASE_URL=sqlite+aiosqlite:///./data/traffic.db
TRAFFIC_DATA_DIR=./data                # résultats json.gz volumineux et uploads

# ─── Modèles ──────────────────────────────────────────────────────────────────
TRAFFIC_WEIGHTS_DIR=./.weights         # git-ignoré : aucun poids dans l'historique
TRAFFIC_DEVICE=auto                    # auto | cpu | 0 | cuda:0
TRAFFIC_HALF=true                      # ignoré hors GPU, et sur un GPU d'avant Volta
# Compensation de mouvement de caméra du tracker : none | sparseOptFlow | orb | sift | ecc
#
# `none` par défaut, et c'est mesuré : sur une caméra FIXE, `sparseOptFlow` coûtait
# 20,2 ms par image — plus que l'inférence GPU — pour corriger un mouvement qui
# n'existe pas. Le retirer double la cadence à comptage strictement identique.
#
# À remettre à `sparseOptFlow` dès que la caméra bouge (plan embarqué, drone, mât
# par grand vent) : sans compensation, le mouvement global se lit comme un mouvement
# des véhicules et `unique_vehicles` gonfle. Voir docs/adr/0013.
TRAFFIC_TRACKER_GMC=none
# Budget de threads d'inférence CPU. 0 = chaque bibliothèque prend tous les cœurs.
#
# Ce défaut est le bon sur une machine dédiée, et le mauvais dès que le navigateur
# tourne sur la même machine — le cas du développement local. Le symptôme n'est pas
# une erreur : c'est LA VIDÉO QUI SACCADE pendant l'analyse, à vitesse normale,
# parce qu'il ne reste aucun cœur pour la décoder. Le diagnostic naturel est « le
# lecteur est mauvais » ; la cause est que le serveur a tout pris.
#
# Poser un à deux cœurs de moins que la machine rend la lecture fluide, contre une
# part de cadence. L'échange SE MESURE (`anpr_bench.py --compare`), il ne se suppose
# pas : il dépend du nombre de cœurs et du plafond thermique de la machine.
#
# CE QU'IL BORNE DÉSORMAIS AUSSI : le détecteur de plaques. Depuis son passage en
# .pt (ADR 0015) il vit sur torch, donc sur ces threads comme le reste. Ce n'était pas
# le cas de l'ancien export .onnx : Ultralytics construisait sa session onnxruntime
# sans SessionOptions, donc ce budget lui était invisible — mesuré à l'époque, 702 ms
# sans budget contre 656 à trois threads, soit deux fois la même chose.
#
# L'OCR reste en onnxruntime, mais son adaptateur passe ses SessionOptions
# explicitement : ce réglage l'atteint (66 → 85 ms la vignette, à trois threads).
TRAFFIC_INFERENCE_THREADS=0

# Threads du parallel_for_ d'OpenCV. 0 ne fait rien (défaut).
#
# Un SECOND robinet, parce que TRAFFIC_INFERENCE_THREADS n'atteint qu'OpenCV via
# torch — c'est-à-dire jamais. Au repos, OpenCV prend TOUS les processeurs logiques
# (12 mesurés ici) quand torch en prend 6, et rien ne les arbitrait. Or le
# prétraitement d'Ultralytics est du pur OpenCV et tourne dans le fil qui attend le
# GPU, pendant que le fil de décodage d'ADR 0031 en veut autant.
#
# 0 par défaut, et c'est MESURÉ, pas prudent. Trois mesures, la troisième décide :
#   micro-banc, machine libre, 3 fils au lieu de 12 : PERD 3,4 %
#   micro-banc avec un fil OpenCV concurrent       : GAGNE 9,7 puis 10,2 %
#   pipeline réel (--anpr --ocr, courses alternées) : AUCUN EFFET
#     20,92 -> 20,97 puis 21,20 -> 21,10 img/s, l'écart change de signe.
#
# Le fil concurrent du micro-banc était un substitut : dans le vrai pipeline, le
# décodage a son propre fil depuis ADR 0031 et le détecteur de plaques domine le
# budget, donc la contention visée ne se produit pas sur ce profil. Le réglage reste
# utile là où elle se produit — un navigateur qui lit la vidéo sur la même machine,
# plusieurs analyses concurrentes — d'où un réglage plutôt qu'une valeur posée.
#
# Ne borne pas le pool du décodeur FFmpeg, qui vit dans son propre fil depuis
# ADR 0031 et dont l'effet n'a pas été mesuré ici.
TRAFFIC_OPENCV_THREADS=0

# Laisser cuDNN choisir ses algorithmes de convolution par la mesure.
#
# false PAR DÉFAUT, ET C'EST UN CORRECTIF. ADR 0013 l'avait activé sur la prémisse que
# « notre forme d'entrée est fixe pour une vidéo donnée ». Vrai du détecteur de
# véhicules ; FAUX du détecteur de plaques, qui reçoit un recadrage différent par piste
# — Ultralytics impose rect=True en prédiction, donc un recadrage soumis seul produit
# une forme d'entrée qui dépend de son rapport d'aspect. cuDNN réétalonne à chaque
# nouvelle forme, et cet étalonnage coûte environ UNE SECONDE.
#
# Mesuré en courses alternées sur le même binaire, ANPR et OCR actives, à détections et
# plaques publiées STRICTEMENT IDENTIQUES :
#   scène clairsemée (1 recadrage/appel) : 7,2 → 14,9 puis 6,1 → 10,4 img/s (1,7 à 2,1×)
#   scène dense (2,4 recadrages/image)   : 8,0 → 10,7 puis 7,8 → 11,9 img/s (1,3 à 1,5×)
# Le pire appel de l'étage de plaques passe de ~1 300-1 500 ms à ~135-270 ms.
#
# Ce que l'autotune rendait au chemin dont la forme EST fixe : rien de mesurable —
# inférence véhicules 7,92 ms avec, 8,00 ms sans. Le réglage existe pour une machine où
# la mesure dirait autre chose : `scripts/pipeline_bench.py --cudnn` la refait.
# Voir ADR 0033.
TRAFFIC_INFERENCE_CUDNN_AUTOTUNE=false
# Côté de l'entrée du réseau de détection des VÉHICULES. 640 est la valeur
# qu'Ultralytics appliquait déjà sans que personne ne l'écrive : la rendre explicite
# ne change aucun chiffre, elle rend seulement réglable ce qui était subi.
#
# L'entrée n'est PAS carrée — `rect=True` est actif en prédiction, donc une image
# 16:9 entre en 640×384. Les gains attendus se calculent sur cette base.
#
# **Le seul réglage de cette section qui peut faire disparaître des véhicules.** À
# calibrer au banc (`scripts/pipeline_bench.py --imgsz …`) sur ses propres vidéos, en
# regardant débit ET comptage.
TRAFFIC_INFERENCE_IMGSZ=640
# Images par lot d'inférence. Une seule image à la fois laisse la carte à moitié
# inoccupée sur un modèle nano. Le suivi n'en souffre pas : Ultralytics remplit un lot
# d'images CONSÉCUTIVES de la même vidéo, et le tracker leur est appliqué une par une,
# dans l'ordre.
#
# Mesuré au banc sur 720p, yolov8n, à comptage strictement identique : 1 → 4 gagne
# 1,16× à 1,37×, et 4 → 8 seulement 1,04× à 1,09×. D'où 4.
#
# **À redescendre sur les paliers large et xlarge si la carte n'a que 4 Go** — c'est
# le cas de cette machine. L'échec est franc (erreur CUDA de mémoire, pas une
# dégradation silencieuse), mais il fait échouer le job.
TRAFFIC_INFERENCE_BATCH=4
# Lots d'inférence calculés D'AVANCE, dans un fil séparé. 0 rend le chemin séquentiel.
# Le jumeau du fil de décodage, un étage plus haut : il recouvre le moteur (détection,
# suivi) avec son aval (plaques, OCR, captures, apparence), qui se relayaient jusque-là.
# GAIN MESURÉ, ET IL EST PETIT : 1,10× quand l'OCR travaille, 1,05× quand elle ne publie
# rien, 1,00× quand elle ne se déclenche jamais. L'aval est lui aussi du GPU aux deux
# tiers, et deux flux CUDA sur une carte se sérialisent — seules les moitiés CPU se
# recouvrent. Aucun comptage, aucun horodatage et aucune plaque ne changent : voir
# ADR 0054, et scripts/pipeline_bench.py --prefetch pour rejouer les courses alternées.
TRAFFIC_INFERENCE_PREFETCH_BATCHES=1
TRAFFIC_DEFAULT_MODEL_ID=yolov8n
TRAFFIC_WARMUP=true                    # false dans les tests : chargerait un vrai modèle
TRAFFIC_MAX_LOADED_MODELS=2            # un modèle résident coûte des centaines de Mo
# Vide = <TRAFFIC_WEIGHTS_DIR>/license-plate.pt.
# Le commentaire est **au-dessus** et non en fin de ligne : après une valeur vide,
# `# …` devient la valeur elle-même, et le service cherche alors un modèle de
# plaques à un chemin nommé « # vide = … ». Il ne le trouve évidemment pas, et
# l'ANPR reste indisponible sans qu'aucun message ne mentionne la vraie cause.
#
# Le suffixe fait partie du contrat : Ultralytics choisit son backend d'après lui.
# Pointer ce réglage sur un `.onnx` fonctionne (la détection ne demande ni tracker ni
# ReID), mais reste sur le CPU — voir la section « Modèle de plaques — récupération ».
TRAFFIC_PLATE_MODEL_PATH=
# Seuil par défaut. La requête peut le remplacer (`plateConfidence`) : c'est le seul
# réglage de plaques qui voyage par requête, parce qu'il répond à une question que
# seul l'utilisateur peut trancher devant sa vidéo.
TRAFFIC_PLATE_CONFIDENCE=0.25
# IoU de la suppression des non-maxima. Le défaut d'Ultralytics (0,70) est calibré
# pour une scène COCO encombrée ; sur une classe unique, 0,45 supprime les doublons
# décalés que 0,70 laissait passer.
TRAFFIC_PLATE_IOU=0.45
# Un véhicule a UNE plaque visible. Le modèle en rend jusqu'à 300 par défaut, et
# elles étaient toutes dessinées puis envoyées à l'OCR.
TRAFFIC_PLATE_MAX_PER_VEHICLE=1
# Mosaïque : n² recadrages de véhicules par inférence. 1 = désactivée.
#
# Elle échange du RAPPEL contre de la vitesse, et l'échange n'est pas gratuit : ce
# qui décide qu'une plaque est trouvée est sa taille dans l'entrée du réseau, et
# elle ne dépend que de la cellule (~0,15 × côté de cellule). Mesuré sur 657
# véhicules de vraie circulation, à 8,2 véhicules par image :
#
#   côté 1 — cellule 616 px — 760 ms/image — rappel 100 %
#   côté 2 — cellule 302 px — 221 ms/image — rappel  84 %
#   côté 3 — cellule 197 px — 116 ms/image — rappel  56 %
#
# Par défaut 1 : on ne troque pas de la justesse contre du débit sans le demander.
# Mettre 2 si le débit prime — 3,4× pour 16 % de détections en moins, largement
# absorbées par le vote qui agrège plusieurs images du même véhicule.
TRAFFIC_PLATE_MOSAIC_SIDE=1

# Côté de l'entrée du détecteur de plaques, en pixels. Multiple de 32 obligatoire.
#
# LE PREMIER POSTE DU BUDGET DÈS QUE L'ANPR TOURNE, et de loin. Mesuré sur une scène
# dense réelle (1920×1080, 6 à 14 véhicules par image, GPU) : l'étage de plaques coûte
# 76 ms par image analysée — 73 % du total — contre 0,4 ms pour l'OCR. Le coût est
# LINÉAIRE en nombre de recadrages (21,5 ms pour un, 139,7 pour huit) : chaque
# véhicule paie une inférence entière, comme une image complète.
#
# Descendre ce côté divise le coût… et le rappel. Mesuré sur 60 images de la même
# vidéo, plaques localisées :
#   640 — 96,1 ms/image — 94 plaques   (le défaut, la résolution d'entraînement)
#   448 — 55,7 ms/image — 22 plaques   (−77 %)
#   320 — 33,5 ms/image —  0 plaque    (l'ANPR ne rend plus rien)
#
# Ne pas descendre sans mesurer sur SES vidéos : le rappel s'effondre bien plus vite
# que le coût ne baisse. Un plan serré, où les plaques sont grandes, peut se comporter
# tout autrement — c'est exactement ce que ce réglage permet de vérifier.
# Voir ADR 0032.
TRAFFIC_PLATE_NET_SIZE=640

# ─── Étranglement du détecteur de plaques (ADR 0010) ──────────────────────────
# LE VRAI GOULOT, et de loin. Mesuré sur un i5-8350U sans GPU, 30 images :
#
#   détection de plaques   702 ms par inférence   (p95 1263 ms)
#   lecture OCR             66 ms par vignette    (p95   83 ms)
#
# Rapport 10,7 à 1. Optimiser l'OCR ne rend donc rien de perceptible ; c'est ici
# qu'il faut dépenser son attention.
#
# Vide = suit TRAFFIC_PLATE_OCR_EVERY_N_FRAMES. Détecter plus souvent qu'on ne lit
# produirait des boîtes que personne ne consomme, puisque c'est la lecture qui
# décide du texte publié.
TRAFFIC_PLATE_DETECT_EVERY_N_FRAMES=
# Sous cette largeur de VÉHICULE, la plaque fera quelques pixels : l'inférence
# coûterait 702 ms sans rien pouvoir trouver. C'est le rejet le moins cher du
# dispositif — il est gratuit à évaluer.
#
# À calibrer au banc, sur SES vidéos : le rapport plaque/véhicule ne se déduit pas.
# Mesuré ici, il vaut 0,5 à 0,9 sur un plan serré et 0,05 à 0,25 sur une vue de
# circulation, soit un facteur dix entre les deux.
TRAFFIC_PLATE_DETECT_MIN_VEHICLE_WIDTH_PX=96.0
# Au-delà de cet âge (en images analysées), une ancre n'est plus reprojetée.
#
# LIÉ AU RÉGLAGE CI-DESSUS, et le lien est vérifié au démarrage : entre deux
# détections espacées de N images, les images sautées portent des ancres d'âge 1 à
# N−1. Un âge plus court laisse des images sans rectangle — le clignotement
# qu'ADR 0010 a supprimé. Monter la cadence sans monter l'âge est LE piège de ce
# couple, et il ne se voit qu'à l'écran : aucun journal, aucun chiffre changé.
TRAFFIC_PLATE_DETECT_MAX_ANCHOR_AGE=4
# Échecs consécutifs (détection soumise, aucune plaque trouvée) au-delà duquel une
# piste sans ancre retombe sur la cadence normale au lieu d'être retentée à CHAQUE
# image analysée.
#
# LE TROU QUE L'ANCRE NE BOUCHE PAS. Une piste dont la plaque n'est structurel-
# lement jamais visible (mauvais angle, trop loin, absente de l'image) n'a jamais
# d'ancre, donc la garde « pas d'ancre → toujours détecter » la retente sans fin.
# Mesuré : sur une vraie vidéo à 9-13 véhicules simultanés, 24 pistes sur 36
# n'ont jamais produit de plaque — certaines pendant 6 à 8 s, chacune payant
# ~800 ms par image analysée. Résultat sans ce réglage : 1,42 image/s traitée,
# contre 11 sans ANPR sur la même vidéo.
TRAFFIC_PLATE_DETECT_MAX_CONSECUTIVE_MISSES=3
# Suspendre une piste dont les plaques MESURÉES restent sous le plancher de lecture.
#
# LE PLUS GROS LEVIER DE CADENCE DE L'ANPR, ET IL NE COÛTE AUCUN TEXTE. Sur une vue
# de circulation réelle (ADR 0032), la détection de plaques pèse 73 % du budget et
# AUCUNE plaque n'y est publiable : elles font moins de 48 px pour un plancher de
# lecture à 64 (TRAFFIC_PLATE_OCR_MIN_WIDTH_PX). Les deux tiers du budget partaient
# donc dans des inférences dont on peut PROUVER qu'elles ne rendront pas de texte.
#
# La porte compare la largeur mesurée SUR CETTE PISTE au MÊME nombre que l'OCR
# utilise pour refuser de lire : une plaque écartée est une plaque qui aurait été
# refusée de toute façon. Elle SUSPEND et n'abandonne pas — la condition
# « largeur_véhicule × rapport >= plancher » redevient vraie toute seule quand le
# véhicule s'approche, sans aucun délai ni facteur à régler.
#
# CE QUI EST RÉELLEMENT PAYÉ : le rectangle disparaît sur ces véhicules-là, après
# les images de reprojection de l'ancre. Le service dit déjà pourquoi
# (plate_unread_reason = too_small, avec la largeur vue). Mettre false rend tous les
# rectangles, au prix de la cadence.
#
# Sans OCR, la porte ne s'arme JAMAIS : le service ne la pose que si un lecteur
# tourne réellement — couper la détection au nom d'un texte que personne n'attend
# retirerait à l'utilisateur la fonctionnalité qu'il a cochée.
TRAFFIC_PLATE_DETECT_READABLE_GATE=true
# Mesures consécutives sous le plancher avant de suspendre. Deux décrivent une
# situation, une seule décrit un instant (plaque à moitié occultée, vue de biais).
TRAFFIC_PLATE_DETECT_READABLE_MIN_SAMPLES=2
# Réarmement d'office toutes les N images analysées. 0 = jamais, le défaut.
# La porte se rouvre déjà seule quand le véhicule grandit : c'est une mesure, pas un
# délai. Ce quota n'existe que pour une piste lisible qui ne grandirait pas.
TRAFFIC_PLATE_DETECT_READABLE_RETRY_EVERY=0
# Recadrages soumis au détecteur par image analysée, au plus. 0 = illimité.
#
# LE SEUL PLAFOND QUI RENDE LE COÛT DE L'ANPR INDÉPENDANT DE LA SCÈNE. Sans lui, la
# cadence suit la circulation : plus de véhicules = plus de recadrages = plus de coût,
# linéairement. Ce qui n'est pas servi sur une image l'est sur la suivante, et le texte
# publié est un vote sur la vie du véhicule : le plafond coûte donc peu en justesse.
# Le budget va d'abord aux pistes jamais mesurées — sinon un véhicule traverserait tout
# le champ sans jamais recevoir de rectangle — puis aux plus larges, dont la plaque a
# le plus de chances de dépasser le plancher de lecture.
#
# À MESURER CHEZ SOI, JAMAIS À SUPPOSER — et son gain est bien plus faible qu'annoncé
# d'abord. Le 1,27× qui lui était attribué venait surtout de ce qu'il évitait les appels
# à un seul recadrage, donc les pauses d'étalonnage cuDNN (ADR 0033). Une fois cette
# cause corrigée, sur la scène dense, comptages identiques :
#   0 (illimité) — 11,0 img/s — 2,28 recadrages/image — 180 plaques localisées
#   2            —  9,0 img/s — 1,74 recadrages/image — 137 plaques localisées
#   1            — 13,8 img/s — 1,00 recadrage/image  —  76 plaques localisées
#
# Deux choses à lire dans ce tableau : le plafond COÛTE DES PLAQUES LOCALISÉES, à peu
# près proportionnellement aux recadrages écartés — c'est le prix, et il est réel — et sa
# cadence ne s'ordonne pas proprement (2 plus lent que 0 sur cette passe, à coût d'étage
# quasi égal). Il borne le coût quand le trafic monte ; il ne l'améliore pas dans le cas
# général. Voir ADR 0032 et ADR 0033.
TRAFFIC_PLATE_DETECT_MAX_PER_FRAME=0

# ─── Lecture du texte de plaque (OCR) ─────────────────────────────────────────
# Vide = <TRAFFIC_WEIGHTS_DIR>/license-plate-ocr.onnx et .charset.txt.
# Commentaire au-dessus, pour la même raison qu'à TRAFFIC_PLATE_MODEL_PATH.
#
# Les DEUX fichiers sont nécessaires, et `plateOcrAvailable` est faux si l'un
# manque. Le dictionnaire dit ce que veut dire l'indice 37 du modèle : un
# dictionnaire d'une autre taille ne lève rien à l'exécution, il produit des
# plaques fausses et parfaitement plausibles. L'adaptateur refuse donc de charger
# si les deux tailles ne correspondent pas (ADR 0007).
TRAFFIC_PLATE_OCR_MODEL_PATH=
TRAFFIC_PLATE_OCR_CHARSET_PATH=
# Plancher de confiance : sous ce seuil, la lecture est écartée **avant** le vote.
# Une chaîne affichée est crue : mieux vaut en afficher moins.
TRAFFIC_PLATE_OCR_MIN_TEXT_SCORE=0.50
# Étranglement. Une image analysée sur N par piste, et pas de relecture quand la
# boîte de plaque n'a pas bougé (IoU au-dessus du seuil). L'économie principale
# n'est ni l'une ni l'autre : c'est l'arrêt complet dès qu'un véhicule a une
# plaque établie.
#
# **Le goulot a changé de camp, et cette ligne disait l'inverse.** Elle affirmait que
# « la détection reste le vrai goulot, pas la lecture ». Deux changements l'ont
# retournée : ADR 0015 a mis le détecteur sur GPU, ADR 0030 lui a fait payer une
# inférence par IMAGE au lieu d'une par véhicule. Mesuré après ADR 0030, par image
# analysée : OCR 262 ms (60 %), suivi des véhicules 90 ms, détection de plaques
# 81 ms. C'est donc CE réglage-ci, et non ceux de la détection, qui gouverne
# aujourd'hui le coût de l'ANPR.
TRAFFIC_PLATE_OCR_EVERY_N_FRAMES=3
# 64 et non 32 : l'échelle de vérité terrain donne 4/8 lectures justes à 64 px et
# 0/8 à 48 px (`anpr_bench.py --truth-ladder`). Ce fichier annonçait encore 32,
# cinq fois plus permissif que la mesure et que le défaut réel du code.
TRAFFIC_PLATE_OCR_MIN_WIDTH_PX=64
# Netteté minimale d'une vignette, en variance de laplacien. `0` désactive la porte.
#
# Porte anti-flou de MOUVEMENT : une plaque large mais floue est aussi illisible
# qu'une plaque nette et minuscule, et la largeur seule ne les distingue pas.
#
# **À calibrer au banc, pas au jugé** : la variance de laplacien dépend du contraste
# de la scène et de la compression du flux, donc sa valeur utile n'est pas
# universelle. Le défaut est délibérément bas — on écarte le franchement flou, pas
# l'imparfait.
TRAFFIC_PLATE_OCR_MIN_SHARPNESS=8.0
TRAFFIC_PLATE_OCR_SKIP_IOU=0.85
# 0 laisse onnxruntime décider. À baisser si TRAFFIC_MAX_CONCURRENT_JOBS dépasse 1 :
# deux analyses créeraient chacune son pool intra-op et se disputeraient les cœurs.
TRAFFIC_PLATE_OCR_INTRA_OP_THREADS=0
# Lire chaque plaque sous plusieurs prétraitements — redressée, cadre rogné — et
# garder la meilleure lecture. Toutes les variantes partent dans le MÊME lot : le
# surcoût est celui de quelques lignes de tenseur, pas d'une inférence de plus.
# C'est le commutateur MAÎTRE : le couper coupe aussi les rognages ci-dessous.
TRAFFIC_PLATE_OCR_VARIANTS=true
# Fractions rognées À GAUCHE, une variante de lecture par valeur. Elles existent
# pour un caractère de tête absent de l'alphabet du modèle — l'idéogramme de
# province d'une plaque chinoise : le décodage doit bien émettre quelque chose pour
# ces pixels, et ce quelque chose mange la lettre voisine. Mesuré : la chaîne
# rendait « 96886 » pour « 苏A·96886 » à 0,90 ; rognée, elle rend « A96886 » à 0,97.
# Vide désactive la famille. Voir ADR 0029 pour le balayage et le plateau.
TRAFFIC_PLATE_OCR_LEFT_INSETS=[0.14,0.22]
# 1.0 = la lecture peut recommencer sans condition de qualité. À 1.25, ce garde
# AFFAMAIT le vote : deux ou trois lectures par véhicule, réparties sur quatre
# graphies voisines, donc aucune ne dominait et rien n'était publié — ou pire, la
# plaque tronquée. TRAFFIC_PLATE_OCR_SKIP_IOU couvre déjà le cas qui motivait ce
# garde (le recadrage figé d'un véhicule arrêté au feu). ADR 0029.
TRAFFIC_PLATE_OCR_QUALITY_IMPROVEMENT=1.0
# Négocier la largeur du tenseur avec le lot au lieu des 320 px de PP-OCR. Une
# plaque européenne tient en 226 px, et une plaque très large cesse d'être comprimée.
TRAFFIC_PLATE_OCR_DYNAMIC_WIDTH=true

# ─── Bornes d'exécution ───────────────────────────────────────────────────────
# Un GPU = une analyse à la fois. Les suivantes attendent en file et sont
# acceptées en 202 « queued », jamais refusées en 503.
TRAFFIC_MAX_CONCURRENT_JOBS=1
TRAFFIC_MAX_REALTIME_SESSIONS=1
TRAFFIC_MAX_UPLOAD_MB=800
# Aperçu live d'une analyse en cours : intervalle minimal entre deux images
# publiées sur le flux SSE, en millisecondes. 0 désactive l'aperçu.
TRAFFIC_PREVIEW_INTERVAL_MS=200
# Le même intervalle, quand l'analyse est bridée sur le temps de la scène
# (`analysisSpeed` dans la requête). Plus serré, parce que brider est la décision de
# regarder l'analyse : à 1×, 200 ms ne montrent que cinq images de scène par seconde.
# N'élargit jamais la valeur ci-dessus — le minimum des deux est retenu. 0 = ne pas
# resserrer (et non « publier chaque image »).
TRAFFIC_PREVIEW_INTERVAL_PACED_MS=100
# Republication du registre des véhicules dans l'aperçu : c'est lui qui remplit le
# tableau et la statistique *pendant* l'analyse. Dix fois plus lent que les boîtes,
# parce que le registre grossit avec l'analyse (≈350 octets par véhicule) alors que
# les boîtes d'une image restent une poignée. 0 = registre vide jusqu'à la fin ;
# l'aperçu final le porte toujours.
TRAFFIC_PREVIEW_VEHICLES_INTERVAL_MS=1000
TRAFFIC_JOB_TTL_MINUTES=1440           # purge des jobs terminaux
# Durée de vie de la vidéo déposée, distincte de celle du job — et alignée sur elle
# par défaut depuis que l'historique sait rejouer une analyse : rouvrir un résultat
# redessine les boîtes sur l'image et déplace la lecture depuis la timeline, ce qui
# demande la vidéo. À 60 minutes, la fonction cessait de marcher au bout d'une heure
# sur des résultats gardés 24.
#
# Le réglage reste séparé, et c'est délibéré : la vidéo est la donnée la plus lourde
# et la plus sensible du service — une scène de trafic contient des plaques réelles et
# des visages, un résultat ne porte que des boîtes et des compteurs. Un déploiement
# qui veut une rétention courte baisse cette valeur seule : il perd le rejeu sur
# image, jamais les chiffres.
TRAFFIC_INPUT_TTL_MINUTES=1440

# ─── Limitation de débit, par adresse IP ──────────────────────────────────────
# Fenêtre glissante, en mémoire du processus. Mettre 0 désactive la limite
# correspondante — utile derrière une passerelle qui limite déjà.
#
# La limite globale n'inclut plus les lectures d'un job précis
# (GET /jobs/{id}...) depuis ADR 0027 : rouvrir une seule analyse archivée
# déclenche à elle seule une vingtaine de requêtes en quelques secondes, dont
# une quinzaine pour la seule vidéo, chargée par plages par le navigateur.
TRAFFIC_RATE_LIMIT_PER_MINUTE=60             # limite globale
TRAFFIC_RATE_LIMIT_JOBS_PER_MINUTE=10        # POST /jobs : chaque dépôt écrit sur le disque
TRAFFIC_RATE_LIMIT_BENCHMARK_PER_HOUR=2      # l'opération la plus coûteuse du service
TRAFFIC_RATE_LIMIT_REALTIME_PER_MINUTE=10    # handshake WS : le CORS ne le voit jamais

# ─── Documentation ────────────────────────────────────────────────────────────
# false en production : un openapi.json public expose la surface d'attaque
# complète. Le service **refuse de démarrer** en production avec les docs
# ouvertes, sauf TRAFFIC_DOCS_PUBLIC=true posé délibérément.
TRAFFIC_DOCS_ENABLED=true
TRAFFIC_DOCS_PUBLIC=false
# Build du frontend servi par le backend (production). Vide = rien n'est servi.
# Commentaire au-dessus, pour la même raison qu'à TRAFFIC_PLATE_MODEL_PATH.
TRAFFIC_STATIC_DIR=

# ─── Modèle de plaques — récupération ─────────────────────────────────────────
# Utilisés par scripts/fetch_plate_model.py, qui vérifie la somme SHA-256 avant
# de ranger le fichier dans TRAFFIC_WEIGHTS_DIR.
#
# Le script vérifie AUSSI que le suffixe de l'URL correspond à celui de la
# destination, et refuse sinon. Ce n'est pas du zèle : Ultralytics choisit son
# backend d'après le SUFFIXE du fichier, jamais d'après son contenu. Un `.pt`
# téléchargé vers `license-plate.onnx` passe l'empreinte, existe sur le disque, rend
# `plateAvailable: true` — et ne détecte jamais rien. Voir ADR 0015.
#
# **Un `.pt`, pas un `.onnx`** (ADR 0015). `onnxruntime` n'expose pas de provider
# CUDA sur les postes de ce projet, donc un ONNX reste cloué au CPU quel que soit le
# GPU présent. Mesuré sur une Quadro P1000, même modèle, même image : 45,2 ms sur GPU
# contre 183,9 ms sur CPU. Un `.pt` lève en plus la contrainte de l'ancien export,
# figé à 1×3×640×640 avec sa grille d'ancres gravée dans le graphe.
#
# Valeurs vérifiées de ce lot — yolo11n affiné sur une classe unique
# « License_Plate », AGPL-3.0 comme ce dépôt. Les variantes s/m/l/x existent au même
# endroit ; nano est le défaut parce que le détecteur tourne par véhicule ET par
# image, et qu'ADR 0008 a montré que la justesse se gagne au filtre géométrique bien
# plus qu'au palier de modèle :
#
#   TRAFFIC_PLATE_MODEL_URL=https://huggingface.co/morsetechlab/yolov11-license-plate-detection/resolve/main/license-plate-finetune-v1n.pt
#   TRAFFIC_PLATE_MODEL_SHA256=0aec75976c56eb6f26dfb274c430620ec65137915ff1ae47c3a48c7af8afb7b2
TRAFFIC_PLATE_MODEL_URL=
TRAFFIC_PLATE_MODEL_SHA256=

# ─── Modèle de lecture (OCR) — récupération ───────────────────────────────────
# Utilisés par scripts/fetch_plate_ocr_model.py, qui vérifie les deux sommes
# SHA-256 **et** contrôle que le dictionnaire correspond bien à la sortie du
# modèle avant de ranger quoi que ce soit.
#
# Le modèle attendu est une tête de reconnaissance PP-OCR **anglaise** exportée en
# ONNX, avec le `en_dict.txt` de PaddleOCR (95 lignes, dont une qui ne contient
# qu'un espace — c'est un caractère de l'alphabet, pas un blanc de mise en forme).
# JAMAIS l'export chinois à 6625 classes : il paierait un softmax 68 fois plus
# large pour lire sept caractères latins.
#
# Les quatre variables sont obligatoires : modèle et dictionnaire sont inséparables,
# et un poids est du code exécuté par le service. Valeurs vérifiées de ce lot :
#
#   TRAFFIC_PLATE_OCR_MODEL_URL=https://huggingface.co/SWHL/RapidOCR/resolve/main/PP-OCRv3/en_PP-OCRv3_rec_infer.onnx
#   TRAFFIC_PLATE_OCR_MODEL_SHA256=ef7abd8bd3629ae57ea2c28b425c1bd258a871b93fd2fe7c433946ade9b5d9ea
#   TRAFFIC_PLATE_OCR_CHARSET_URL=https://raw.githubusercontent.com/PaddlePaddle/PaddleOCR/main/ppocr/utils/en_dict.txt
#   TRAFFIC_PLATE_OCR_CHARSET_SHA256=5662df9d2d03f0e8ca0d3b0649d6acbab904b6a14b3d3521463c71c37c668ce3
TRAFFIC_PLATE_OCR_MODEL_URL=
TRAFFIC_PLATE_OCR_MODEL_SHA256=
TRAFFIC_PLATE_OCR_CHARSET_URL=
TRAFFIC_PLATE_OCR_CHARSET_SHA256=

# ─── Ressemblance de véhicule (recherche par image) ───────────────────────────
# Encodeur d'apparence. Vide = <TRAFFIC_WEIGHTS_DIR>/vehicle-reid.onnx.
# Commentaire au-dessus de la clé, pour la même raison qu'à TRAFFIC_PLATE_MODEL_PATH.
TRAFFIC_REID_MODEL_PATH=

# Plancher de similarité cosinus sous lequel aucun score n'est publié. `0` publie
# tout : c'est le défaut, parce que le seuil qui compte est celui de l'utilisateur,
# côté client, et qu'il doit pouvoir descendre sans réanalyser (ADR 0048).
TRAFFIC_REID_MIN_SIMILARITY=0.0

# Largeur de véhicule, en pixels, sous laquelle on n'encode pas. L'entrée du réseau
# fait 208 px : sous ce plancher, agrandir n'apporte aucune information et l'embedding
# ressemble surtout au flou. Mesuré par scripts/reid_bench.py --truth-ladder.
TRAFFIC_REID_MIN_VEHICLE_WIDTH_PX=96.0

# Netteté minimale (variance du laplacien) d'un recadrage encodé. Même métrique que
# TRAFFIC_PLATE_OCR_MIN_SHARPNESS.
TRAFFIC_REID_MIN_SHARPNESS=8.0

# Marge de largeur exigée pour RÉENCODER une piste déjà encodée (ADR 0050).
#
# La règle monotone d'ADR 0048 — « plus large que la meilleure vue » — ne bornait
# rien : sur un véhicule qui approche, la largeur croît de façon quasi monotone, donc
# elle est vraie à presque chaque image analysée. On payait jusqu'à un encodage par
# image, 21,8 ms de CPU mesurés par vignette, pour un étage annoncé comme « une fois
# par véhicule ».
#
# 1.15 autorise au plus log_1,15(400/96) ≈ 11 encodages sur la vie d'une piste, contre
# une centaine sans marge. Le bornage est LOGARITHMIQUE : pousser à 1.5 ne diviserait
# le compte que par deux de plus, en coûtant plus de séparation.
#
# Ce que ça coûte : la séparation same/diff décroît régulièrement (+0,462 à 208 px,
# +0,310 à 48 px, sans falaise), donc 15 % de largeur en moins valent ~0,015 — pour un
# seuil client à 0,55 et des moyennes mesurées à 0,816 et 0,249.
#
# 1.0 désactive la marge et reproduit ADR 0048 au bit près.
TRAFFIC_REID_APPEARANCE_IMPROVEMENT=1.15

# Plafond d'encodages d'apparence PAR IMAGE. 0 = illimité (défaut).
#
# Le jumeau de TRAFFIC_PLATE_DETECT_MAX_PER_FRAME, et il borne autre chose que la
# marge ci-dessus : celle-ci borne le total sur la vie d'une piste, celui-ci la
# RAFALE sur une image. Sans lui, une image chargée peut soumettre jusqu'à 16
# vignettes à 21,8 ms pièce — ~350 ms de blocage CPU en un seul appel, pendant
# lequel le GPU dort et l'aperçu ne sort pas.
#
# Ce n'est pas un gain de moyenne, c'est un plafond de pire cas : ce qu'on en voit
# est un aperçu qui cesse de hoqueter. Ce qui n'est pas servi n'est pas perdu — la
# piste repasse candidate à l'image suivante.
TRAFFIC_REID_MAX_PER_FRAME=0

# Threads intra-op d'onnxruntime pour l'encodeur d'apparence. 0 = repli sur
# TRAFFIC_INFERENCE_THREADS.
#
# Le même trou que l'OCR avait comblé, resté ouvert dans ce second adaptateur : ses
# SessionOptions étaient construites sans budget, donc TRAFFIC_INFERENCE_THREADS
# atteignait torch et l'OCR mais pas lui.
#
# Mesuré ici : défaut(0) 17,0 ms, 3 fils 17,5, 6 fils 18,5, 12 fils 31,9 ms. Borner
# à 3 coûte 3 % et rend trois cœurs au reste ; forcer 12 est 1,9x PIRE —
# l'hyperthreading dessert ce graphe.
TRAFFIC_REID_INTRA_OP_THREADS=0

# ─── Encodeur de ressemblance — récupération ──────────────────────────────────
# Utilisées par scripts/fetch_reid_model.py uniquement. Le service ne télécharge
# jamais de lui-même : c'est la leçon d'ADR 0047, où une bibliothèque allait chercher
# un poids toute seule et le déposait dans le répertoire courant, en silence.
#
# `vehicle-reid-0001` de l'Open Model Zoo : OSNet-AIN entraîné sur VeRi-776, entrée
# 1×3×208×208 en RGB (le graphe est en fait dynamique), sortie 1×512 comparée par
# distance cosinus, 2,18 MParams, 2,64 GFLOPs, licence MIT (Kaiyang Zhou).
# Rank-1 96,31 % / mAP 85,15 % sur VeRi-776 — à comparer à FastREID (81,9 mAP) et
# TransREID (82,3) pour des modèles bien plus lourds.
#
# L'empreinte SHA-384 publiée par l'OMZ dans son `model.yml` a été vérifiée avant de
# noter le SHA-256 ci-dessous, que ce dépôt utilise par convention :
#
#   TRAFFIC_REID_MODEL_URL=https://storage.openvinotoolkit.org/repositories/open_model_zoo/public/2022.1/vehicle-reid-0001/osnet_ain_x1_0_vehicle_reid.onnx
#   TRAFFIC_REID_MODEL_SHA256=4aaad3e5db648618b0df3d2ff21c61323985ff9e50194c3d2edd4fb87c92d91f
TRAFFIC_REID_MODEL_URL=
TRAFFIC_REID_MODEL_SHA256=
