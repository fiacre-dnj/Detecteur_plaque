# Configuration du service — copier en `.env` et adapter.
# `.env` est ignoré par git ; ce fichier-ci est committé et fait référence.
#
# Le code ne lit `os.environ` nulle part : un unique objet Settings
# (src/traffic_analysis/core/settings.py) est chargé au démarrage et injecté.
#
# Une clé mal orthographiée **dans ce fichier** fait échouer le démarrage avec le
# nom fautif, plutôt que d'être ignorée en silence — sans quoi on baisserait la
# limite d'upload en croyant l'avoir faite et elle resterait à 800 Mo. Une
# variable d'environnement mal orthographiée, en revanche, reste indétectable.

# ─── Exécution ────────────────────────────────────────────────────────────────
TRAFFIC_ENV=development                # development | staging | test | production
TRAFFIC_HOST=127.0.0.1
TRAFFIC_PORT=8000

# ─── Journalisation ───────────────────────────────────────────────────────────
TRAFFIC_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
TRAFFIC_LOG_FORMAT=console             # console en développement, json en production

# ─── CORS et hôtes ────────────────────────────────────────────────────────────
# Liste EXPLICITE, jamais "*" — le démarrage échoue si "*" apparaît.
# `localhost` et `127.0.0.1` sont deux origines distinctes pour le navigateur :
# les deux doivent être présentes, sinon « ça marche sur l'une et pas l'autre ».
# En développement la voie normale est le proxy Vite (same-origin) ; CORS n'est
# que le filet pour les appels directs et l'outillage.
TRAFFIC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Pour les déploiements de prévisualisation. Doit être ancrée par ^ et $, sinon
# https://evil.com/#mon-domaine.dev la satisferait par son fragment.
TRAFFIC_CORS_ORIGIN_REGEX=
TRAFFIC_CORS_ALLOW_CREDENTIALS=false
TRAFFIC_TRUSTED_HOSTS=["localhost","127.0.0.1"]

# ─── Persistance ──────────────────────────────────────────────────────────────
TRAFFIC_DATABASE_URL=sqlite+aiosqlite:///./data/traffic.db
TRAFFIC_DATA_DIR=./data                # résultats json.gz volumineux et uploads

# ─── Modèles ──────────────────────────────────────────────────────────────────
TRAFFIC_WEIGHTS_DIR=./.weights         # git-ignoré : aucun poids dans l'historique
TRAFFIC_DEVICE=auto                    # auto | cpu | 0 | cuda:0
TRAFFIC_HALF=true                      # ignoré hors GPU : en fp16 sur CPU, ça ralentit
TRAFFIC_DEFAULT_MODEL_ID=yolov8n
TRAFFIC_WARMUP=true                    # false dans les tests : chargerait un vrai modèle
TRAFFIC_MAX_LOADED_MODELS=2            # un modèle résident coûte des centaines de Mo
TRAFFIC_PLATE_MODEL_PATH=              # vide = <TRAFFIC_WEIGHTS_DIR>/license-plate.onnx
TRAFFIC_PLATE_CONFIDENCE=0.25

# ─── Bornes d'exécution ───────────────────────────────────────────────────────
# Un GPU = une analyse à la fois. Les suivantes attendent en file et sont
# acceptées en 202 « queued », jamais refusées en 503.
TRAFFIC_MAX_CONCURRENT_JOBS=1
TRAFFIC_MAX_REALTIME_SESSIONS=1
TRAFFIC_MAX_UPLOAD_MB=800
# Aperçu live d'une analyse en cours : intervalle minimal entre deux images
# publiées sur le flux SSE, en millisecondes. 0 désactive l'aperçu.
TRAFFIC_PREVIEW_INTERVAL_MS=200
TRAFFIC_JOB_TTL_MINUTES=1440           # purge des jobs terminaux
# La vidéo part **avant** le résultat, et pas pour la place disque : une scène de
# trafic contient des plaques réelles et des visages, un résultat ne contient que
# des boîtes et des compteurs.
TRAFFIC_INPUT_TTL_MINUTES=60

# ─── Limitation de débit, par adresse IP ──────────────────────────────────────
# Fenêtre glissante, en mémoire du processus. Mettre 0 désactive la limite
# correspondante — utile derrière une passerelle qui limite déjà.
TRAFFIC_RATE_LIMIT_PER_MINUTE=60             # limite globale
TRAFFIC_RATE_LIMIT_JOBS_PER_MINUTE=10        # POST /jobs : chaque dépôt écrit sur le disque
TRAFFIC_RATE_LIMIT_BENCHMARK_PER_HOUR=2      # l'opération la plus coûteuse du service
TRAFFIC_RATE_LIMIT_REALTIME_PER_MINUTE=10    # handshake WS : le CORS ne le voit jamais

# ─── Documentation ────────────────────────────────────────────────────────────
# false en production : un openapi.json public expose la surface d'attaque
# complète. Le service **refuse de démarrer** en production avec les docs
# ouvertes, sauf TRAFFIC_DOCS_PUBLIC=true posé délibérément.
TRAFFIC_DOCS_ENABLED=true
TRAFFIC_DOCS_PUBLIC=false
TRAFFIC_STATIC_DIR=                    # build frontend servi par le backend (prod)

# ─── Modèle de plaques — récupération ─────────────────────────────────────────
# Utilisés par scripts/fetch_plate_model.py, qui vérifie la somme SHA-256 avant
# de ranger le fichier dans TRAFFIC_WEIGHTS_DIR.
TRAFFIC_PLATE_MODEL_URL=
TRAFFIC_PLATE_MODEL_SHA256=
