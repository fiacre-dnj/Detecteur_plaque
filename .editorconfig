root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne sont une coupure de ligne en Markdown.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab
